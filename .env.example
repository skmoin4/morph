# ---------- Core ----------
NODE_ENV=development
TZ=UTC

# ---------- API ----------
API_PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Network ----------
# Reverse proxies in front of the API (0 = none). Office-network punches use the
# caller's IP, so only raise this when a proxy you control sets X-Forwarded-For.
TRUST_PROXY=0
# Background jobs (attendance day-closing). Needs Redis.
JOBS_ENABLED=true

# ---------- Database (Laragon MySQL 8) ----------
DATABASE_URL="mysql://root:@127.0.0.1:3306/opsvera?connection_limit=10"

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# ---------- Redis / BullMQ (Laragon Redis) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Storage ----------
# development = local disk | production = s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/api/v1/files
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=opsvera
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------- Email (Laragon Mailpit in dev) ----------
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OPSVERA <no-reply@opsvera.local>"

# ---------- Web ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
